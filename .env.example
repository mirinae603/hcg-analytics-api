# Database (existing)
DATABASE_USERNAME=
DATABASE_PASSWORD=

# AI Analyst — Azure OpenAI. Set these on Render (dashboard → Environment).
# The key is a secret; never commit the real value.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://ed-gpt.openai.azure.com
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-4o
# Smaller model for follow-up suggestions and other light calls, in fast and deep mode.
# Optional — defaults to "gpt-4o-mini". Must exist on the same Azure resource. (The older
# name AZURE_OPENAI_DEPLOYMENT_MINI is still read as a fallback.)
AZURE_OPENAI_MINI_DEPLOYMENT=gpt-4o-mini
# Embeddings deployment used for AI-Analyst intent routing (same key/endpoint as above).
# Optional — defaults to "text-embedding-3-large". If this deployment is missing or
# unreachable, routing degrades gracefully (fail-open) and the chatbot still works.
AZURE_OPENAI_EMBED_DEPLOYMENT=text-embedding-3-large

# Auth — production MUST set these; the dev defaults in app/core/config.py are public.
# Left commented out: an empty value here would override the default with "".
# JWT_SECRET_KEY=
# SEED_ADMIN_PASSWORD=
# ADMIN_REFRESH_TOKEN=
# Browser origins allowed to call the API (exact list + regex for Azure Static Web Apps).
# CORS_ORIGINS=http://localhost:3000,https://hcg.bidezy.com
# CORS_ORIGIN_REGEX=https://.*\.azurestaticapps\.net

# Sales ETL (python -m app.etl.ingest_sales) only: the folder holding "IP Sales" and
# "OP Sales". Defaults to RAW_DATA_DIR. Not needed to run the API.
# SALES_RAW=
# Where python -m app.etl.repair_sales_codes --write backs up the originals.
# SALES_REPAIR_BACKUP=~/Documents/HCG/hcg-work/snapshots
