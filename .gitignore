# Secrets — never commit
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/

# OS / editor
.DS_Store
*.log

# local user store (seeded at runtime)
app/data/users.json

# local SQLite DB (users, chat sessions/messages) — seeded/migrated at runtime
app/data/app.db
app/data/app.db-journal
app/data/*.db
app/data/*.db-journal
